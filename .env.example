# Copia este archivo a .env.local y rellena los valores.
# Sin ellos la app funciona igual, pero guarda todo solo en el navegador.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Google Tag Manager. El contenedor es el mismo en todos los entornos; lo que
# cambia es el entorno de GTM, que viaja en VITE_GTM_PARAMS.
#
# Déjalas vacías en local: sin un id con forma de GTM-XXXX no se carga nada, y
# así las pruebas de desarrollo no ensucian las métricas.
#
#   DEV   &gtm_auth=Uk4Bd2mGMzXHs0usOxRRiA&gtm_preview=env-3&gtm_cookies_win=x
#   QA    &gtm_auth=xbHmMNb3aKdF_xXxasSLVw&gtm_preview=env-4&gtm_cookies_win=x
#   PRE   &gtm_auth=vl9oKNwVgYNCqYSO66FUYg&gtm_preview=env-5&gtm_cookies_win=x
#   PROD  (vacío: el entorno publicado no lleva parámetros)
VITE_GTM_ID=
VITE_GTM_PARAMS=

# Solo para el script `npm run cargar` (nunca se expone al navegador).
ANTHROPIC_API_KEY=sk-ant-...
